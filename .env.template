# Copy to .env and fill in. Never commit .env.
# Suffix 1 = the working DB (stage). common/db.py also accepts the unsuffixed DB_* and POSTGRES_*
# spellings, but the Augmentation/SoilVoc scripts read DB_*1 (and DB_*2) directly, so keep the suffix.
DB_HOST1=
DB_PORT1=5432
DB_NAME1=msp-kh-stage
DB_USER1=
DB_PASSWORD1=
DB_SCHEMA1=validate

# Optional, suffix 2 = dev (msp-kh-dev). Only read, only by Augmentation/SoilVoc/03_stage_vs_dev.
# DB_HOST2=
# DB_PORT2=5432
# DB_NAME2=msp-kh-dev
# DB_USER2=
# DB_PASSWORD2=
# DB_SCHEMA2=validate

# Set to 1 to make every DB connection read-only (verification runs)
# MSP_READ_ONLY=1
